# Portal-owned PostgreSQL database. Do not reuse the backend database or role.
ConnectionStrings__Portal=Host=localhost;Port=5432;Database=giftcard_portal;Username=giftcard_portal_app;Password=replace-me

# Pinned backend development URL.
Backend__BaseUrl=http://localhost:5143

# Required outside Development. Use an access-controlled persistent volume
# shared by every instance of this application.
DataProtection__KeysPath=C:\replace-with-a-durable-protected-path

# Optional: trust exactly one ingress hop. Use only the immediate proxy's
# literal address; never a hostname, subnet guessed from DNS, or client value.
# Networking__ForwardedHeaders__KnownProxies__0=127.0.0.1
